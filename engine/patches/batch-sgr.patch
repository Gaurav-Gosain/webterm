+/// Apply one complete SGR command before interning its final cursor style.
+/// Intermediate styles cannot be observed: parsing has already consumed the
+/// command, and attributes do not emit terminal effects. Keep the ordinary
+/// single-attribute path for direct callers and allocation-failure recovery.
+pub fn setAttributes(self: *Screen, parser: *sgr.Parser) PageList.IncreaseCapacityError!void {
+    const old_style = self.cursor.style;
+    while (parser.next()) |attr| {
+        // With commit=false this only changes the cursor value; it cannot
+        // allocate, change pages, or touch style reference counts.
+        self.setAttributeInner(attr, false) catch unreachable;
+    }
+    if (self.cursor.style.eql(old_style)) return;
+    self.manualStyleUpdate() catch |err| {
+        self.cursor.style = old_style;
+        self.manualStyleUpdate() catch {
+            self.cursor.style = .{};
+            self.manualStyleUpdate() catch unreachable;
+        };
+        return err;
+    };
+}
