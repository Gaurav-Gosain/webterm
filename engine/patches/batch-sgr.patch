+test "Screen batched SGR grows a full style map" {
+    const testing = std.testing;
+    var s = try Screen.init(testing.io, testing.allocator, .{ .cols = 10, .rows = 5, .max_scrollback_bytes = 10 });
+    defer s.deinit();
+    try s.testWriteString("line1\nline2\nline3\nline4\nline5");
+    const old_page = s.cursor.page_pin.node.page();
+    const old_capacity = old_page.capacity.styles;
+    {
+        old_page.pauseIntegrityChecks(true);
+        defer old_page.pauseIntegrityChecks(false);
+        defer old_page.assertIntegrity();
+        for (1..old_page.styles.layout.cap) |n| {
+            _ = old_page.styles.add(old_page.memory, .{ .bg_color = .{ .rgb = @bitCast(@as(u24, @intCast(n))) } }) catch break;
+        }
+    }
+    var parser: sgr.Parser = .{ .params = &.{ 1, 3, 38, 2, 12, 34, 56, 48, 5, 42 }, .params_sep = .empty };
+    try s.setAttributes(&parser);
+    const page = s.cursor.page_pin.node.page();
+    try testing.expect(page != old_page or page.capacity.styles > old_capacity);
+    try testing.expect(s.cursor.style.flags.bold and s.cursor.style.flags.italic);
+    try testing.expect(page.styles.get(page.memory, s.cursor.style_id).eql(s.cursor.style));
+    try s.testWriteString("batch");
+}
