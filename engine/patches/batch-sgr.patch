+test "Screen batched SGR matches individual attributes and preserves references" {
+    const testing = std.testing;
+    var batch = try Screen.init(testing.io, testing.allocator, .{ .cols = 80, .rows = 24, .max_scrollback_bytes = 1000 });
+    defer batch.deinit();
+    var single = try Screen.init(testing.io, testing.allocator, .{ .cols = 80, .rows = 24, .max_scrollback_bytes = 1000 });
+    defer single.deinit();
+    const sequences = [_][]const u16{
+        &.{ 0, 1, 3, 4, 38, 2, 123, 45, 67, 48, 5, 42, 58, 2, 90, 80, 70 },
+        &.{ 22, 23, 24, 39, 49, 59 },
+        &.{ 1, 2, 22, 4, 24, 38, 5, 120, 39, 0 },
+        &.{ 7, 8, 9, 53, 31, 44 },
+        &.{},
+    };
+    for (sequences) |params| {
+        var parser: sgr.Parser = .{ .params = params, .params_sep = .empty };
+        var original = parser;
+        try batch.setAttributes(&parser);
+        while (original.next()) |attr| try single.setAttribute(attr);
+        try testing.expect(batch.cursor.style.eql(single.cursor.style));
+        const page = batch.cursor.page_pin.node.page();
+        if (batch.cursor.style.default()) {
+            try testing.expectEqual(style.default_id, batch.cursor.style_id);
+        } else {
+            try testing.expect(page.styles.get(page.memory, batch.cursor.style_id).eql(batch.cursor.style));
+        }
+        try batch.testWriteString("X");
+        try single.testWriteString("X");
+    }
+    // Intermediate resets that return to the same style must preserve its ID.
+    try batch.setAttribute(.bold);
+    const id = batch.cursor.style_id;
+    const count = batch.cursor.page_pin.node.page().styles.count();
+    var noop: sgr.Parser = .{ .params = &.{ 22, 1 }, .params_sep = .empty };
+    try batch.setAttributes(&noop);
+    try testing.expectEqual(id, batch.cursor.style_id);
+    try testing.expectEqual(count, batch.cursor.page_pin.node.page().styles.count());
+}
